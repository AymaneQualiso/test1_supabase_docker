# Copy to scripts/.env (git-ignored) and fill in.
# NO "VITE_" prefix here: Vite copies VITE_* variables into the browser bundle.

# API URL from `npx supabase status`
SUPABASE_URL=http://127.0.0.1:55321

# "Secret" key from `npx supabase status` (sb_secret_...). Server-side only.
SUPABASE_SECRET_KEY=

# Shared password for all local test users. Pick your own; local stack only.
SEED_USERS_PASSWORD=
